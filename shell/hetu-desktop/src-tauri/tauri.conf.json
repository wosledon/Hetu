{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hetu",
  "version": "0.3.3",
  "identifier": "com.hetu.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hetu",
        "url": "index.html",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3QjVENDM4RUMwQ0YzRjIKUldUeTh3enNPTlMxSnp4TzRhQWR4ZGp5SENhUElvUEF0aXhlZlY4bXZwQ1FrUnU1OFJwOUNvbisK",
      "endpoints": [
        "https://github.com/wosledon/Hetu/releases/latest/download/latest.json",
        "https://ghproxy.net/https://github.com/wosledon/Hetu/releases/latest/download/latest-mirror.json",
        "https://gh-proxy.com/https://github.com/wosledon/Hetu/releases/latest/download/latest-mirror2.json",
        "https://ghfast.top/https://github.com/wosledon/Hetu/releases/latest/download/latest-mirror3.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

