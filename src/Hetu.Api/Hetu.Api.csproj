<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ConPTY 的 LibraryImport 源生成 P/Invoke 需要不安全代码块 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 产品版本：与桌面壳 shell/hetu-desktop/src-tauri/tauri.conf.json 的 version 保持一致，
         前端「关于」页通过 GET /api/system/version 读取此处 -->
    <Version>0.3.16</Version>
    <!--
      关掉 .NET SDK 的静态资源预压缩：它会给 wwwroot 里每个 js/css 生成 .br 和 .gz 副本
      （约 5 MB）。而本应用用的是 UseStaticFiles()（物理文件提供程序），并不做预压缩协商——
      实测直接请求 .br 返回 404，压缩是由 UseResponseCompression() 在运行时做的。
      这些副本纯粹是安装包里的死重量。
    -->
    <EnableDefaultCompressedItems>false</EnableDefaultCompressedItems>
    <!--
      桌面 sidecar 用工作站 GC：Web SDK 默认打开 Server GC（每个逻辑核心一套 GC 堆 + GC 线程），
      那是给多核服务器调的。本后端是跟着桌面壳起的单用户进程，Server GC 只增加开销——
      实测 16 核机器上线程 41 → 21，已提交内存 100.8 → 75.9 MB（−25%）。
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- 发布产物不带 pdb：安装包里只用单文件 exe，pdb 留在 artifacts 不会进包；
         Serilog 的异常堆栈仍可用（只是没有行号） -->
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.2.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Hetu.Core/Hetu.Core.csproj" />
    <ProjectReference Include="../Hetu.Infrastructure/Hetu.Infrastructure.csproj" />
    <ProjectReference Include="../Hetu.Infrastructure.PostgresMigrations/Hetu.Infrastructure.PostgresMigrations.csproj" />
    <ProjectReference Include="../Hetu.Shared/Hetu.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../Hetu.Infrastructure/sqlite-vec/vec0.dll" Link="sqlite-vec/vec0.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Release 构建时自动构建前端 SPA 并复制到 wwwroot，供 ASP.NET Core 托管。
    可通过 /p:SkipFrontendBuild=true 跳过（CI/devloop 场景）。
  -->
  <PropertyGroup>
    <FrontendProjectDir>$(MSBuildThisFileDirectory)..\..\frontend</FrontendProjectDir>
    <FrontendDistDir>$(FrontendProjectDir)\dist</FrontendDistDir>
    <FrontendWwwroot>$(MSBuildThisFileDirectory)wwwroot</FrontendWwwroot>
  </PropertyGroup>

  <Target Name="BuildFrontendSpa" BeforeTargets="AssignTargetPaths;PrepareForBuild" Condition="'$(Configuration)' == 'Release' AND '$(SkipFrontendBuild)' != 'true' AND Exists('$(FrontendProjectDir)\package.json')">
    <Message Importance="high" Text="[Hetu] Building frontend SPA at $(FrontendProjectDir)" />
    <Exec Command="npm ci" WorkingDirectory="$(FrontendProjectDir)" Condition="!Exists('$(FrontendProjectDir)\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(FrontendProjectDir)" />
    <ItemGroup>
      <_FrontendDistFiles Include="$(FrontendDistDir)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FrontendDistFiles)" DestinationFiles="@(_FrontendDistFiles->'$(FrontendWwwroot)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- 让构建出来的 wwwroot 在 publish 时随产物一起发布。
       用 Update 而非 Include：SDK 已默认包含 wwwroot 的 Content，避免 NETSDK1022 重复。 -->
  <ItemGroup Condition="Exists('$(FrontendWwwroot)\index.html')">
    <Content Update="wwwroot\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>

