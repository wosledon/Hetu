<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Foundry Local 本地模型运行时 SDK（Microsoft.AI.Foundry.Local）。
      包本身不带平台条件，Linux/macOS 也能正常 restore；原生库由它依赖的
      Microsoft.AI.Foundry.Local.Runtime 按 RuntimeIdentifier 自动拷贝
      （runtimes\&lt;rid&gt;\native\*.*），Windows 之外的可用性由运行时守卫决定。
      之所以要在 src/Directory.Build.props 里声明 RuntimeIdentifiers，是因为该 Runtime 包的
      buildTransitive 会把空的 RuntimeIdentifier 强写成 $(NETCoreSdkRuntimeIdentifier)，
      restore 不带 RID 时就对不上资产文件，报 NETSDK1047。
    -->
    <PackageReference Include="Microsoft.AI.Foundry.Local" Version="2.2.1" />
    <PackageReference Include="Cronos" Version="0.8.4" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.4" />
    <!-- 固定 SQLitePCLRaw 版本：2.1.11 及以下带的 e_sqlite3 存在高危漏洞（GHSA-2m69-gcr7-jv3q） -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"
      Version="10.0.0-preview.5.25277.114" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.4" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Hetu.Core/Hetu.Core.csproj" />
    <ProjectReference Include="../Hetu.Shared/Hetu.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 本地化文案：Locales/{zh,en}/*.json 作为嵌入资源随程序集发布（单文件 sidecar 也能读到） -->
    <EmbeddedResource Include="Localization\Locales\**\*.json" />
  </ItemGroup>

</Project>